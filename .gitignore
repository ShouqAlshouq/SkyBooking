# ---------------------------------------------------------------
# SkyBooking .gitignore  (Xcode / SwiftUI / Swift Package Manager)
# ---------------------------------------------------------------

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
._*

# --- Xcode: per-user state (contains your username + window layout) ---
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# --- Xcode: build output ---
build/
DerivedData/
*.xcarchive

# --- Swift Package Manager ---
.build/
.swiftpm/
# NOTE: Package.resolved is intentionally NOT ignored.
# For an app, commit it so everyone builds the exact same Firebase version.

# --- CocoaPods / Carthage (not used today, harmless if added later) ---
Pods/
Carthage/Build/

# --- Fastlane (if you ever add it) ---
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# --- Secrets & local config ---
# Firebase client config: contains your project's API key and IDs.
# Keep it out of a public repo; teammates copy GoogleService-Info.plist.example
# to SkyBooking/GoogleService-Info.plist and fill in their own values.
# (If your repo is PRIVATE and your instructor needs to run the app, you can
#  delete this line and commit the file instead.)
SkyBooking/GoogleService-Info.plist
.env
*.p12
*.pem
*.mobileprovision

# --- Course paperwork (not part of the app) ---
*Rubric*.docx
